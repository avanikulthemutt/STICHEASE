let cart = loadStorage("stitcheaseFashionCart", []);
let savedDesigns = loadStorage("stitcheaseSavedDesigns", []);

let faceLandmarker = null;
let faceImageFile = null;
let faceImageElement = null;

function loadStorage(key, fallback) {
    try {
        const value = JSON.parse(localStorage.getItem(key));
        return Array.isArray(value) ? value : fallback;
    } catch {
        return fallback;
    }
}

function element(id) {
    return document.getElementById(id);
}

const money = amount =>
    "₹" + Number(amount).toLocaleString("en-IN");


/* =========================================
   PRODUCT COLLECTION
========================================= */

function displayProducts() {
    const category = element("filterCategory").value;
    const size = element("filterSize").value;
    const colour = element("filterColour").value;
    const occasion = element("filterOccasion").value;
    const maxPrice = Number(element("maxPrice").value);
    const sort = element("sortProducts").value;

    let filtered = products.filter(product => {
        return (
            (category === "All" || product.category === category) &&
            (size === "All" || product.sizes.includes(size)) &&
            (colour === "All" || product.colour === colour) &&
            (occasion === "All" || product.occasion === occasion) &&
            product.price <= maxPrice
        );
    });

    if (sort === "low") {
        filtered.sort((a, b) => a.price - b.price);
    } else if (sort === "high") {
        filtered.sort((a, b) => b.price - a.price);
    }

    element("resultCount").textContent =
        filtered.length +
        (filtered.length === 1 ? " piece available" : " pieces available");

    const grid = element("productGrid");

    if (!filtered.length) {
        grid.innerHTML = `
            <div class="no-products">
                <h3>No matching products found</h3>
                <p>Try changing your filters to explore more styles.</p>
            </div>
        `;
        return;
    }

    grid.innerHTML = filtered.map(product => `
        <article class="product-card">

            <div class="product-details">
                <span class="product-category">
                    ${product.category}
                </span>

                <h3>${product.name}</h3>

                <div class="product-price">
                    ${money(product.price)}
                </div>

                <div class="product-meta">
                    ★ ${product.rating} · ${product.occasion}
                </div>

                <div class="product-sizes">
                    Sizes: ${product.sizes.join(", ")}
                </div>

                <div class="product-actions">

                    <button onclick="viewProduct(${product.id})">
                        View Details
                    </button>

                    <button
                        class="customise-product"
                        onclick="customiseProduct(${product.id})">
                        Customise this style
                    </button>

                    <button onclick="addToCart(${product.id})">
                        + Add to Bag
                    </button>

                </div>
            </div>
        </article>
    `).join("");
}

function viewProduct(id) {
    const product = products.find(item => item.id === id);

    if (!product) return;

    alert(
        product.name + "\n\n" +
        "Category: " + product.category + "\n" +
        "Price: " + money(product.price) + "\n" +
        "Rating: " + product.rating + "\n" +
        "Occasion: " + product.occasion + "\n" +
        "Available sizes: " + product.sizes.join(", ")
    );
}

function customiseProduct(id) {
    const product = products.find(item => item.id === id);

    if (!product) return;

    const outfitMap = {
        "Sarees": "Saree",
        "Blouses": "Blouse",
        "Kurtis": "Kurti",
        "Salwar Suits": "Salwar suit",
        "Gowns": "Gown",
        "Dresses": "Dress"
    };

    if (outfitMap[product.category]) {
        element("designOutfit").value = outfitMap[product.category];
    }

    if ([...element("designColour").options].some(
        option => option.value === product.colour
    )) {
        element("designColour").value = product.colour;
    }

    updateDesignSummary();

    element("studio").scrollIntoView({
        behavior: "smooth"
    });
}


/* =========================================
   FILTERS AND CATEGORY BUTTONS
========================================= */

[
    "filterCategory",
    "filterSize",
    "filterColour",
    "filterOccasion",
    "maxPrice",
    "sortProducts"
].forEach(id => {
    element(id).addEventListener("input", () => {
        element("priceValue").textContent =
            money(element("maxPrice").value);

        displayProducts();
    });
});

element("clearFilters").addEventListener("click", () => {
    element("filterCategory").value = "All";
    element("filterSize").value = "All";
    element("filterColour").value = "All";
    element("filterOccasion").value = "All";
    element("maxPrice").value = 15000;
    element("sortProducts").value = "featured";

    element("priceValue").textContent = "₹15,000";

    displayProducts();
});

document.querySelectorAll(".category-card").forEach(card => {
    card.addEventListener("click", () => {
        const category = card.dataset.category;

        if (category === "Custom Outfits") {
            element("studio").scrollIntoView({
                behavior: "smooth"
            });
            return;
        }

        element("filterCategory").value = category;

        displayProducts();

        element("shop").scrollIntoView({
            behavior: "smooth"
        });
    });
});

element("trendingButton").addEventListener("click", () => {
    element("filterCategory").value = "All";
    element("sortProducts").value = "featured";
    displayProducts();
});


/* =========================================
   SHOPPING CART
========================================= */

function saveCart() {
    localStorage.setItem(
        "stitcheaseFashionCart",
        JSON.stringify(cart)
    );

    updateCart();
}

function addToCart(id) {
    const product = products.find(item => item.id === id);

    if (!product) return;

    cart.push({
        id: Date.now(),
        name: product.name,
        price: product.price,
        type: "Ready-made"
    });

    saveCart();
    toggleCart(true);
}

function addCustomDesignToCart() {
    const design = getDesign();

    cart.push({
        id: Date.now(),
        name: design.Outfit + " - Custom design",
        price: estimatePrice(),
        type: "Custom design"
    });

    saveCart();
    toggleCart(true);
}

function removeCartItem(id) {
    cart = cart.filter(item => item.id !== id);
    saveCart();
}

function updateCart() {
    element("cartCount").textContent = cart.length;

    const container = element("cartItems");

    if (!cart.length) {
        container.innerHTML = `
            <div class="cart-empty">
                <span>♡</span>
                <p>Your cart is empty.</p>
                <small>Add a ready-made piece or a custom design.</small>
            </div>
        `;
    } else {
        container.innerHTML = cart.map(item => `
            <div class="cart-item">
                <div>
                    <strong>${item.name}</strong>
                    <small>${item.type}</small>
                    <small>${money(item.price)}</small>
                </div>

                <button
                    class="remove-item"
                    onclick="removeCartItem(${item.id})">
                    Remove
                </button>
            </div>
        `).join("");
    }

    const total = cart.reduce(
        (sum, item) => sum + Number(item.price),
        0
    );

    element("cartTotal").textContent = money(total);
}

function toggleCart(open) {
    element("cartDrawer").classList.toggle("open", open);
    element("cartBackdrop").classList.toggle("show", open);
    document.body.style.overflow = open ? "hidden" : "";
}

element("openCart").addEventListener("click", () => {
    toggleCart(true);
});

element("closeCart").addEventListener("click", () => {
    toggleCart(false);
});

element("cartBackdrop").addEventListener("click", () => {
    toggleCart(false);
});

element("checkoutButton").addEventListener("click", () => {
    if (!cart.length) {
        alert("Your cart is empty. Add a product first.");
        return;
    }

    alert(
        "Your cart is ready!\n\n" +
        "Total: " +
        money(cart.reduce((sum, item) => sum + item.price, 0)) +
        "\n\nCheckout can be connected to your STITCHEASE backend."
    );
});


/* =========================================
   CUSTOMISATION STUDIO
========================================= */

function getDesign() {
    return {
        Outfit: element("designOutfit").value,
        Fabric: element("designFabric").value,
        Colour: element("designColour").value,
        Neckline: element("designNeckline").value,
        Sleeve: element("designSleeve").value,
        Length: element("designLength").value,
        Embroidery: element("designEmbroidery").value,
        Occasion: element("designOccasion").value
    };
}

function estimatePrice() {
    const design = getDesign();

    let price = 1800;

    const fabricPrices = {
        Silk: 900,
        Cotton: 200,
        Georgette: 450,
        Velvet: 850,
        Chanderi: 700
    };

    const embroideryPrices = {
        None: 0,
        "Light zari": 600,
        "Heavy zari": 1800,
        "Thread work": 900,
        "Mirror work": 1100
    };

    price += fabricPrices[design.Fabric] || 0;
    price += embroideryPrices[design.Embroidery] || 0;

    if (design.Occasion === "Wedding") price += 700;
    if (design.Occasion === "Party") price += 300;

    return price;
}

function colourCode(colour) {
    const colours = {
        Maroon: "#70263C",
        Teal: "#167C80",
        Gold: "#B58B24",
        Navy: "#071B35",
        Ivory: "#D9D0BA",
        Emerald: "#08764C",
        Rose: "#C8798B"
    };

    return colours[colour] || "#071B35";
}

function updateDesignSummary() {
    const design = getDesign();

    element("designSummary").innerHTML =
        Object.entries(design).map(([key, value]) => `
            <div class="summary-item">
                <small>${key}</small>
                <strong>${value}</strong>
            </div>
        `).join("");

    element("designEstimate").textContent =
        money(estimatePrice());

    element("previewArt").style.background =
        `linear-gradient(135deg, ${colourCode(design.Colour)}, #071B35)`;
}

document.querySelectorAll("#designForm select").forEach(select => {
    select.addEventListener("change", updateDesignSummary);
});

element("recommendButton").addEventListener("click", () => {
    const design = getDesign();

    updateDesignSummary();

    let recommendation =
        `Your ${design.Colour} ${design.Fabric} ${design.Outfit.toLowerCase()} ` +
        `is a lovely choice for a ${design.Occasion.toLowerCase()} occasion. `;

    if (design.Occasion === "Wedding") {
        recommendation +=
            "Consider detailed zari work and elegant traditional jewellery.";
    } else if (design.Occasion === "Festive") {
        recommendation +=
            "Try statement earrings and complementary embroidery.";
    } else {
        recommendation +=
            "Keep the styling balanced with accessories that complement your outfit.";
    }

    alert(recommendation);
});

element("saveDesign").addEventListener("click", () => {
    savedDesigns.push({
        id: Date.now(),
        details: getDesign(),
        price: estimatePrice()
    });

    localStorage.setItem(
        "stitcheaseSavedDesigns",
        JSON.stringify(savedDesigns)
    );

    displaySavedDesigns();

    alert("Your design has been saved!");
});

element("addCustomToCart").addEventListener(
    "click",
    addCustomDesignToCart
);

function displaySavedDesigns() {
    const container = element("savedDesigns");

    if (!savedDesigns.length) {
        container.innerHTML = `
            <div class="saved-empty">
                <span>♡</span>
                <p>No saved designs yet.</p>
                <small>Create one in the studio and select Save design.</small>
            </div>
        `;
        return;
    }

    container.innerHTML = savedDesigns.map(item => `
        <article class="saved-card">
            <h3>${item.details.Outfit}</h3>

            <p>
                ${item.details.Fabric} · ${item.details.Colour}<br>
                ${item.details.Embroidery} · ${item.details.Occasion}
            </p>

            <strong>${money(item.price)}</strong>

            <button onclick="deleteSavedDesign(${item.id})">
                Remove design
            </button>
        </article>
    `).join("");
}

function deleteSavedDesign(id) {
    savedDesigns = savedDesigns.filter(
        item => item.id !== id
    );

    localStorage.setItem(
        "stitcheaseSavedDesigns",
        JSON.stringify(savedDesigns)
    );

    displaySavedDesigns();
}


/* =========================================
   AI FACE DETECTOR
   MediaPipe Face Landmarker
   Runs in the browser
========================================= */

async function loadFaceDetector() {
    if (faceLandmarker) {
        return faceLandmarker;
    }

    element("faceStatus").textContent =
        "Loading AI face detector. Please wait...";

    try {
        const visionModule = await import(
            "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/+esm"
        );

        const { FilesetResolver, FaceLandmarker } = visionModule;

        const fileset = await FilesetResolver.forVisionTasks(
            "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm"
        );

        faceLandmarker = await FaceLandmarker.createFromOptions(
            fileset,
            {
                baseOptions: {
                    modelAssetPath:
                        "https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task",
                    delegate: "CPU"
                },
                runningMode: "IMAGE",
                numFaces: 1
            }
        );

        return faceLandmarker;

    } catch (error) {
        console.error("Face detector loading error:", error);

        throw new Error(
            "Could not load the AI face detector. Check your internet connection and try again."
        );
    }
}


/* FACE PHOTO UPLOAD */

element("faceUpload").addEventListener("change", event => {
    const file = event.target.files[0];

    if (!file) return;

    if (!file.type.startsWith("image/")) {
        alert("Please select a valid image.");
        return;
    }

    if (file.size > 10 * 1024 * 1024) {
        alert("Please upload an image smaller than 10 MB.");
        event.target.value = "";
        return;
    }

    faceImageFile = file;

    const reader = new FileReader();

    reader.onload = () => {
        const image = new Image();

        image.onload = () => {
            faceImageElement = image;

            element("facePreview").innerHTML = "";
            element("facePreview").appendChild(image);

            element("faceResults").hidden = true;

            element("faceStatus").textContent =
                "Photo uploaded. Select Analyse my face to continue.";
        };

        image.src = reader.result;
        image.alt = "Uploaded face for face landmark analysis";
    };

    reader.readAsDataURL(file);
});


/* DISTANCE BETWEEN FACE LANDMARKS */

function landmarkDistance(a, b) {
    return Math.sqrt(
        Math.pow(a.x - b.x, 2) +
        Math.pow(a.y - b.y, 2)
    );
}


/* FACE SHAPE ESTIMATION */

function estimateFaceShape(landmarks) {
    const foreheadWidth = landmarkDistance(
        landmarks[127],
        landmarks[356]
    );

    const cheekWidth = landmarkDistance(
        landmarks[234],
        landmarks[454]
    );

    const jawWidth = landmarkDistance(
        landmarks[172],
        landmarks[397]
    );

    const faceHeight = landmarkDistance(
        landmarks[10],
        landmarks[152]
    );

    const widthHeightRatio = cheekWidth / faceHeight;
    const foreheadCheekRatio = foreheadWidth / cheekWidth;
    const jawCheekRatio = jawWidth / cheekWidth;

    if (widthHeightRatio > 0.82) {
        if (jawCheekRatio > 0.82) {
            return "Round";
        }

        return "Square";
    }

    if (faceHeight / cheekWidth > 1.48) {
        return "Oblong";
    }

    if (foreheadCheekRatio > 0.94 && jawCheekRatio < 0.78) {
        return "Heart";
    }

    if (jawCheekRatio > 0.82 && foreheadCheekRatio > 0.82) {
        return "Square";
    }

    return "Oval";
}


/* STYLING SUGGESTIONS */

function getFaceRecommendations(shape) {
    const recommendations = {
        Oval: {
            description:
                "Your facial proportions appear relatively balanced. Many traditional styling options may complement this face shape.",
            neckline:
                "Boat neck, sweetheart neck and V-neck",
            earrings:
                "Jhumkas, chandbalis and studs",
            tip:
                "Experiment with different saree drapes and blouse designs."
        },

        Round: {
            description:
                "Your facial proportions appear softer, with a relatively balanced width and height.",
            neckline:
                "V-neck and sweetheart neck",
            earrings:
                "Long jhumkas and drop earrings",
            tip:
                "Try longer earring styles and vertically detailed blouse designs."
        },

        Square: {
            description:
                "Your facial proportions appear to have a broader jawline and balanced facial width.",
            neckline:
                "Sweetheart neck and rounded necklines",
            earrings:
                "Curved chandbalis and rounded jhumkas",
            tip:
                "Try softer curves and delicate jewellery details."
        },

        Heart: {
            description:
                "Your facial proportions appear broader around the forehead and narrower towards the chin.",
            neckline:
                "Boat neck and wide necklines",
            earrings:
                "Chandbalis and wider statement earrings",
            tip:
                "Try balanced accessories and detailed blouse necklines."
        },

        Oblong: {
            description:
                "Your facial proportions appear longer than they are wide.",
            neckline:
                "Boat neck and square neck",
            earrings:
                "Wide jhumkas and statement chandbalis",
            tip:
                "Try wider jewellery styles and horizontal blouse details."
        }
    };

    return recommendations[shape] || recommendations.Oval;
}


/* RUN FACE ANALYSIS */

element("analyseFace").addEventListener("click", async () => {
    if (!faceImageElement || !faceImageFile) {
        alert("Please upload a face photo first.");
        return;
    }

    const button = element("analyseFace");

    button.disabled = true;
    button.textContent = "Analysing...";

    element("faceResults").hidden = true;

    try {
        const detector = await loadFaceDetector();

        element("faceStatus").textContent =
            "Detecting facial landmarks...";

        const result = detector.detect(faceImageElement);

        if (
            !result.faceLandmarks ||
            result.faceLandmarks.length === 0
        ) {
            element("faceStatus").textContent =
                "No face detected. Please upload a clear, front-facing photo.";

            return;
        }

        const landmarks = result.faceLandmarks[0];

        const faceShape = estimateFaceShape(landmarks);
        const suggestions = getFaceRecommendations(faceShape);

        element("faceShapeResult").textContent =
            "Your estimated face shape: " + faceShape;

        element("faceDescription").textContent =
            suggestions.description;

        element("necklineSuggestion").textContent =
            suggestions.neckline;

        element("earringSuggestion").textContent =
            suggestions.earrings;

        element("styleSuggestion").textContent =
            suggestions.tip;

        element("faceResults").hidden = false;

        element("faceStatus").textContent =
            "Face detected successfully. Your style suggestions are ready!";

        element("faceResults").scrollIntoView({
            behavior: "smooth",
            block: "nearest"
        });

    } catch (error) {
        console.error(error);

        element("faceStatus").textContent =
            error.message ||
            "Face analysis failed. Please try again.";

    } finally {
        button.disabled = false;
        button.textContent = "Analyse my face";
    }
});


/* =========================================
   FASHION ASSISTANT
========================================= */

function addChatMessage(message, type) {
    const chat = element("chatMessages");
    const bubble = document.createElement("div");

    bubble.className = "chat-message " + type;
    bubble.textContent = message;

    chat.appendChild(bubble);
    chat.scrollTop = chat.scrollHeight;
}

function getFashionResponse(message) {
    const question = message.toLowerCase();

    if (
        question.includes("wedding") ||
        question.includes("marriage")
    ) {
        return "For a wedding, consider a Banarasi silk saree, an embroidered blouse or a velvet gown. Gold jewellery and elegant jhumkas can complete the look.";
    }

    if (
        question.includes("festive") ||
        question.includes("festival")
    ) {
        return "For a festive look, try a silk saree, a colourful kurti or a salwar suit with zari or mirror work. Add statement earrings for a traditional finish.";
    }

    if (
        question.includes("blouse") ||
        question.includes("neckline")
    ) {
        return "You can explore boat neck, V-neck, square neck and sweetheart neck blouse designs. Try zari, mirror work or thread embroidery to personalise your blouse.";
    }

    if (
        question.includes("colour") ||
        question.includes("color")
    ) {
        return "Gold, emerald, maroon, navy and rose are beautiful ethnic-wear colour choices. Consider the outfit, occasion and your personal preference when selecting a colour.";
    }

    if (
        question.includes("jhumka") ||
        question.includes("earring")
    ) {
        return "Jhumkas are a lovely addition to ethnic outfits. Choose antique gold for traditional looks, or lighter statement earrings for everyday styling.";
    }

    if (
        question.includes("saree")
    ) {
        return "For a classic look, explore Banarasi silk, Chanderi or lightweight sarees. You can personalise the blouse with your preferred neckline, sleeve style and embroidery.";
    }

    if (
        question.includes("office") ||
        question.includes("daily") ||
        question.includes("casual")
    ) {
        return "For everyday wear, try cotton kurtis, simple salwar suits and lightweight accessories. Comfortable fabrics and subtle designs work beautifully.";
    }

    return "I'd suggest exploring our sarees, blouses, kurtis and jhumkas. You can also use the Customisation Studio to choose your own fabric, colour, neckline and embroidery.";
}

function sendChatMessage(message) {
    if (!message.trim()) return;

    addChatMessage(message, "user-message");

    addChatMessage(
        getFashionResponse(message),
        "assistant-message"
    );
}

element("chatForm").addEventListener("submit", event => {
    event.preventDefault();

    const input = element("chatInput");

    sendChatMessage(input.value);
    input.value = "";
});

document.querySelectorAll(".suggestion").forEach(button => {
    button.addEventListener("click", () => {
        sendChatMessage(button.textContent);
    });
});


/* =========================================
   INSPIRATION IMAGE PREVIEW
========================================= */

element("inspirationUpload").addEventListener("change", event => {
    const file = event.target.files[0];

    if (!file) return;

    if (!file.type.startsWith("image/")) {
        alert("Please select an image file.");
        return;
    }

    const reader = new FileReader();

    reader.onload = () => {
        element("visualPreview").innerHTML = "";

        const image = document.createElement("img");
        image.src = reader.result;
        image.alt = "Uploaded design inspiration";

        element("visualPreview").appendChild(image);
    };

    reader.readAsDataURL(file);
});

element("generateConcept").addEventListener("click", () => {
    const design = getDesign();

    alert(
        "Your design idea is ready!\n\n" +
        "Outfit: " + design.Outfit + "\n" +
        "Fabric: " + design.Fabric + "\n" +
        "Colour: " + design.Colour + "\n" +
        "Embroidery: " + design.Embroidery + "\n\n" +
        "You can save this design or add it to your bag."
    );
});


