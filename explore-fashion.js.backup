let cart = JSON.parse(localStorage.getItem("stitcheaseFashionCart") || "[]");
let savedDesigns = JSON.parse(localStorage.getItem("stitcheaseSavedDesigns") || "[]");

const money = amount => "₹" + Number(amount).toLocaleString("en-IN");

function element(id) {
    return document.getElementById(id);
}

/* =========================================
   PRODUCT DISPLAY
========================================= */

function displayProducts() {
    const category = element("filterCategory").value;
    const size = element("filterSize").value;
    const colour = element("filterColour").value;
    const occasion = element("filterOccasion").value;
    const maxPrice = Number(element("maxPrice").value);
    const sort = element("sortProducts").value;

    let filtered = products.filter(product => {
        return (
            (category === "All" || product.category === category) &&
            (size === "All" || product.sizes.includes(size)) &&
            (colour === "All" || product.colour === colour) &&
            (occasion === "All" || product.occasion === occasion) &&
            product.price <= maxPrice
        );
    });

    if (sort === "low") {
        filtered.sort((a,b) => a.price - b.price);
    } else if (sort === "high") {
        filtered.sort((a,b) => b.price - a.price);
    }

    element("resultCount").textContent =
        filtered.length + (filtered.length === 1 ? " piece to explore" : " pieces to explore");

    const grid = element("productGrid");

    if (!filtered.length) {
        grid.innerHTML = `
            <div class="no-products">
                <h3>No matching products found</h3>
                <p>Try changing your filters to explore more styles.</p>
            </div>`;
        return;
    }

    grid.innerHTML = filtered.map(product => `
        <article class="product-card">
            <div class="product-photo">
                <img src="${product.image}" alt="${product.name}" loading="lazy">
                ${product.tag ? `<span class="product-tag">${product.tag}</span>` : ""}
            </div>

            <div class="product-details">
                <span class="product-category">${product.category}</span>
                <h3>${product.name}</h3>
                <div class="product-price">${money(product.price)}</div>
                <div class="product-meta">★ ${product.rating} · ${product.occasion}</div>
                <div class="product-sizes">Sizes: ${product.sizes.join(", ")}</div>

                <div class="product-actions">
                    <button class="view-product" onclick="viewProduct(${product.id})">
                        View Details
                    </button>
                    <button class="customise-product" onclick="customiseProduct(${product.id})">
                        Customise with AI
                    </button>
                    <button class="view-product" onclick="addToCart(${product.id})">
                        + Add to Cart
                    </button>
                </div>
            </div>
        </article>
    `).join("");
}

function viewProduct(id) {
    const product = products.find(item => item.id === id);
    if (!product) return;

    alert(
        product.name + "\n\n" +
        "Category: " + product.category + "\n" +
        "Price: " + money(product.price) + "\n" +
        "Rating: " + product.rating + "\n" +
        "Occasion: " + product.occasion + "\n\n" +
        "Product details and size selection can be connected to the backend."
    );
}

function customiseProduct(id) {
    const product = products.find(item => item.id === id);
    if (!product) return;

    element("designOutfit").value =
        product.category === "Kurtis" ? "Kurti" :
        product.category === "Sarees" ? "Saree blouse" :
        product.category === "Blouses" ? "Blouse" :
        product.category === "Salwar Suits" ? "Salwar suit" :
        product.category === "Gowns" ? "Gown" : "Dress";

    element("designColour").value = product.colour;

    updateDesignSummary();
    document.getElementById("studio").scrollIntoView({behavior:"smooth"});
}

/* FILTER EVENTS */

[
    "filterCategory",
    "filterSize",
    "filterColour",
    "filterOccasion",
    "maxPrice",
    "sortProducts"
].forEach(id => {
    element(id).addEventListener("input", () => {
        element("priceValue").textContent = money(element("maxPrice").value);
        displayProducts();
    });
});

element("clearFilters").addEventListener("click", () => {
    element("filterCategory").value = "All";
    element("filterSize").value = "All";
    element("filterColour").value = "All";
    element("filterOccasion").value = "All";
    element("maxPrice").value = 15000;
    element("sortProducts").value = "featured";
    element("priceValue").textContent = "₹15,000";
    displayProducts();
});

document.querySelectorAll(".category-card").forEach(card => {
    card.addEventListener("click", () => {
        const category = card.dataset.category;

        if (category === "Custom Outfits") {
            document.getElementById("studio").scrollIntoView({behavior:"smooth"});
            return;
        }

        element("filterCategory").value = category;
        displayProducts();
        document.getElementById("shop").scrollIntoView({behavior:"smooth"});
    });
});

/* =========================================
   SHOPPING CART
========================================= */

function saveCart() {
    localStorage.setItem("stitcheaseFashionCart", JSON.stringify(cart));
    updateCart();
}

function addToCart(id) {
    const product = products.find(item => item.id === id);
    if (!product) return;

    cart.push({
        id: Date.now(),
        name: product.name,
        price: product.price,
        type: "Ready-made"
    });

    saveCart();
    toggleCart(true);
}

function addCustomDesignToCart() {
    const design = getDesign();
    const price = estimatePrice();

    cart.push({
        id: Date.now(),
        name: design.Outfit + " - Custom design",
        price: price,
        type: "Custom design"
    });

    saveCart();
    toggleCart(true);
}

function removeCartItem(id) {
    cart = cart.filter(item => item.id !== id);
    saveCart();
}

function updateCart() {
    element("cartCount").textContent = cart.length;

    const container = element("cartItems");

    if (!cart.length) {
        container.innerHTML = `
            <div class="cart-empty">
                <span>♡</span>
                <p>Your cart is empty.</p>
                <small>Add a ready-made piece or a custom design.</small>
            </div>`;
    } else {
        container.innerHTML = cart.map(item => `
            <div class="cart-item">
                <div>
                    <strong>${item.name}</strong>
                    <small>${item.type}</small>
                    <small>${money(item.price)}</small>
                </div>
                <button class="remove-item" onclick="removeCartItem(${item.id})">
                    Remove
                </button>
            </div>
        `).join("");
    }

    const total = cart.reduce((sum,item) => sum + item.price, 0);
    element("cartTotal").textContent = money(total);
}

function toggleCart(open) {
    element("cartDrawer").classList.toggle("open", open);
    element("cartBackdrop").classList.toggle("show", open);
    document.body.style.overflow = open ? "hidden" : "";
}

element("checkoutButton").addEventListener("click", () => {
    if (!cart.length) {
        alert("Your cart is empty. Add a product first.");
        return;
    }

    alert(
        "Your cart is ready!\n\n" +
        "Total: " + money(cart.reduce((sum,item) => sum + item.price,0)) +
        "\n\nCheckout will be connected to your STITCHEASE backend in the next phase."
    );
});

/* =========================================
   CUSTOMISATION STUDIO
========================================= */

function getDesign() {
    return {
        Outfit: element("designOutfit").value,
        Fabric: element("designFabric").value,
        Colour: element("designColour").value,
        Neckline: element("designNeckline").value,
        Sleeve: element("designSleeve").value,
        Length: element("designLength").value,
        Embroidery: element("designEmbroidery").value,
        Occasion: element("designOccasion").value
    };
}

function estimatePrice() {
    const design = getDesign();

    let price = 1800;

    const fabricPrices = {
        Silk: 900,
        Cotton: 200,
        Georgette: 450,
        Velvet: 850,
        Chanderi: 700
    };

    const embroideryPrices = {
        None: 0,
        "Light zari": 600,
        "Heavy zari": 1800,
        "Thread work": 900,
        "Mirror work": 1100
    };

    price += fabricPrices[design.Fabric] || 0;
    price += embroideryPrices[design.Embroidery] || 0;

    if (design.Occasion === "Wedding") price += 700;
    if (design.Occasion === "Party") price += 300;

    return price;
}

function updateDesignSummary() {
    const design = getDesign();

    element("designSummary").innerHTML =
        Object.entries(design).map(([key,value]) => `
            <div class="summary-item">
                <small>${key}</small>
                <strong>${value}</strong>
            </div>
        `).join("");

    element("designEstimate").textContent = money(estimatePrice());

    element("previewArt").style.background =
        `linear-gradient(135deg, ${colourCode(design.Colour)}, #071B35)`;
}

function colourCode(colour) {
    const colours = {
        Maroon: "#70263C",
        Teal: "#167C80",
        Gold: "#B58B24",
        Navy: "#071B35",
        Ivory: "#D9D0BA",
        Emerald: "#08764C",
        Rose: "#C8798B"
    };

    return colours[colour] || "#071B35";
}

document.querySelectorAll("#designForm select").forEach(select => {
    select.addEventListener("change", updateDesignSummary);
});

element("recommendButton").addEventListener("click", () => {
    updateDesignSummary();

    alert(
        "Your design preferences have been arranged!\n\n" +
        "The AI fashion recommendation service will be connected through the backend in the next phase."
    );
});

element("saveDesign").addEventListener("click", () => {
    const design = getDesign();

    savedDesigns.push({
        id: Date.now(),
        details: design,
        price: estimatePrice()
    });

    localStorage.setItem("stitcheaseSavedDesigns", JSON.stringify(savedDesigns));

    displaySavedDesigns();
    alert("Your design has been saved!");
});

element("addCustomToCart").addEventListener("click", addCustomDesignToCart);

function displaySavedDesigns() {
    const container = element("savedDesigns");

    if (!savedDesigns.length) {
        container.innerHTML = `
            <div class="saved-empty">
                <span>♡</span>
                <p>No saved designs yet.</p>
                <small>Create one in the studio and select Save design.</small>
            </div>`;
        return;
    }

    container.innerHTML = savedDesigns.map(item => `
        <article class="saved-card">
            <h3>${item.details.Outfit}</h3>
            <p>
                ${item.details.Fabric} · ${item.details.Colour}<br>
                ${item.details.Embroidery} · ${item.details.Occasion}
            </p>
            <strong>${money(item.price)}</strong><br>
            <button onclick="deleteSavedDesign(${item.id})">Remove design</button>
        </article>
    `).join("");
}

function deleteSavedDesign(id) {
    savedDesigns = savedDesigns.filter(item => item.id !== id);
    localStorage.setItem("stitcheaseSavedDesigns", JSON.stringify(savedDesigns));
    displaySavedDesigns();
}

/* =========================================
   AI ASSISTANT - FRONTEND DEMO
========================================= */

function addChatMessage(message, type) {
    const chat = element("chatMessages");
    const bubble = document.createElement("div");

    bubble.className = "chat-message " + type;
    bubble.textContent = message;

    chat.appendChild(bubble);
    chat.scrollTop = chat.scrollHeight;
}

function sendChatMessage(message) {
    if (!message.trim()) return;

    addChatMessage(message, "user-message");

    addChatMessage(
        "Thank you for sharing! I can help you explore outfits, colours and styling ideas. The personalised AI response service will be connected to the backend in the next phase.",
        "assistant-message"
    );
}

element("chatForm").addEventListener("submit", event => {
    event.preventDefault();

    const input = element("chatInput");
    sendChatMessage(input.value);
    input.value = "";
});

document.querySelectorAll(".suggestion").forEach(button => {
    button.addEventListener("click", () => {
        sendChatMessage(button.textContent);
    });
});

/* =========================================
   INSPIRATION IMAGE PREVIEW
========================================= */

element("inspirationUpload").addEventListener("change", event => {
    const file = event.target.files[0];
    if (!file) return;

    if (!file.type.startsWith("image/")) {
        alert("Please select an image file.");
        return;
    }

    const reader = new FileReader();

    reader.onload = () => {
        element("visualPreview").innerHTML =
            `<img src="${reader.result}" alt="Your inspiration image">`;
    };

    reader.readAsDataURL(file);
});

element("generateConcept").addEventListener("click", () => {
    alert(
        "Your design preferences are ready!\n\n" +
        "AI outfit image generation will be connected through the backend in the next phase."
    );
});

/* =========================================
   HOMEPAGE ACCOUNT NAVIGATION
========================================= */

function goToAccount(section) {
    sessionStorage.setItem("stitcheaseReturnSection", section);
    return true;
}

/* INITIALISE */

displayProducts();
updateDesignSummary();
displaySavedDesigns();
updateCart();
